# Fitnerds! env. Copy to .env.local and fill in.

# Supabase project URL + anon key.
#
# These two MUST be NEXT_PUBLIC_ — the browser opens the realtime websocket
# directly to Supabase (see SPEC.md). The anon key is designed to be public;
# security is enforced server-side by RLS policies in schema.sql, not by
# hiding this key. Same model as a Firebase web API key.
#
# Never add a NEXT_PUBLIC_ prefix to anything else from Supabase. The
# service_role key bypasses RLS and must stay server-only (not used in v1).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Allow-list of emails. Comma-separated. Used by middleware to redirect
# anyone else to /denied. Mirror these in the `allowed_emails` SQL table.
ALLOWED_EMAILS=rayner@example.com,ada@example.com
