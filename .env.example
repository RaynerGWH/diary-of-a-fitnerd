# Rayner OS env. Copy to .env.local and fill in.

# Supabase project URL + anon key.
#
# These two MUST be NEXT_PUBLIC_: the browser opens the realtime websocket
# directly to Supabase (see the security section in README.md). The anon key
# is designed to be public;
# security is enforced server-side by RLS policies in schema.sql, not by
# hiding this key. Same model as a Firebase web API key.
#
# Never add a NEXT_PUBLIC_ prefix to anything else from Supabase. The
# service_role key bypasses RLS and must stay server-only (not used in v1).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Allow-list of emails. Comma-separated. Used by middleware to redirect
# anyone else to /denied. Mirror these in the `allowed_emails` SQL table.
ALLOWED_EMAILS=rayner@example.com

# OpenRouter API key for the /capture chat parser. Server-only: read inside
# src/lib/ai/openrouter.ts, never NEXT_PUBLIC_. Get one at openrouter.ai/keys.
OPENROUTER_API_KEY=
# Optional: override the model used to parse chat messages into entries.
# OPENROUTER_MODEL=qwen/qwen3.7-flash

# ------------------------------------------------------------------
# Custom MCP connector (the jobs board)
# ------------------------------------------------------------------

# Public origin of this deployment, no trailing slash. Every OAuth metadata
# document has to agree on it byte for byte, and the client compares issuers
# with a plain string comparison, so a stray slash breaks the connector in a
# way that is annoying to debug. On Vercel this falls back to the project's
# production URL if unset, but set it explicitly for the branch you're testing.
APP_URL=https://your-app.vercel.app

# Supabase service_role key. Bypasses RLS completely.
#
# Needed because the MCP endpoint and the OAuth token endpoint are called by
# Anthropic's servers with no Supabase session, so there is no auth.uid() for
# RLS to key off; those routes scope every query to a user_id they have already
# proven from the bearer token. Server-only, read in src/lib/supabase/service.ts.
SUPABASE_SERVICE_ROLE_KEY=

# The single pre-registered OAuth client: Claude. Paste these two into
# claude.ai -> Connectors -> Add custom connector -> Advanced settings.
# Generate the secret with: openssl rand -hex 32
MCP_OAUTH_CLIENT_ID=rayner-os-claude
MCP_OAUTH_CLIENT_SECRET=

# Optional: extra redirect URIs to accept during the OAuth flow, comma-separated.
# claude.ai's own callback is always allowed. Use this to let a local
# mcp-inspector run through, and take it back out afterwards: an authorization
# server that redirects anywhere hands out authorization codes to anyone.
# MCP_OAUTH_REDIRECT_URIS=http://localhost:6274/oauth/callback
