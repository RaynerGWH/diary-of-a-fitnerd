# Rayner OS agent service. Copy to .env and fill in.
# Nothing here is required for /health to answer — secrets are asserted where
# they're used, so a missing one never stops the container from booting.

ENV=local

# Shared with the Next app, which mints a 60-second HS256 JWT per request.
# The user id comes from that token and never from a request body.
# Generate with: openssl rand -hex 32
AGENT_SHARED_SECRET=

# Same project as the Next app. The service_role key bypasses RLS, which is why
# every query in this service scopes to a user id proven from the JWT above.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# The model. Provider-agnostic: OpenAI, OpenRouter and most gateways speak the
# same API, so switching is these two vars, not a code change.
#
#   OpenAI direct     leave LLM_BASE_URL unset
#   OpenRouter        LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=gpt-4o-mini

# Legacy: still read if LLM_API_KEY is unset, so an existing OpenRouter setup
# keeps working. OPENROUTER_API_KEY alone also implies the OpenRouter base URL.
# OPENROUTER_API_KEY=

# LangSmith. On in dev and prod: the runs worth diagnosing are the ones you
# didn't reproduce locally. Traces carry journal text, so keep the project
# private. Cold start never appears here — that's Init Duration in CloudWatch.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=rayner-agent-local
